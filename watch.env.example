# Copy to ~/.grok-cursor/watch.env and chmod 600. Never commit the filled-in copy.
# HTTPS endpoint that receives watcher events (finished, approval_needed, cursor_updated, ...).
GROK_CURSOR_WATCH_URL=
# Sent as "Authorization: Bearer <key>".
GROK_CURSOR_WATCH_KEY=
# Optional: launchd label (default com.grok-cursor.watch).
# GROK_CURSOR_WATCH_LABEL=
