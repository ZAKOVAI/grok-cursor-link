#!/usr/bin/env python3
"""grok-cursor-hook: record local Cursor agent activity for your Grok Bot.

Cursor runs this script for the hook events registered by install.sh
(sessionStart, beforeSubmitPrompt, afterAgentResponse, stop, sessionEnd).
It reads the documented hook JSON payload from stdin and writes, under
~/.grok-cursor (override with GROK_CURSOR_HOME):

  chats/<conversation_id>.md   append-only markdown log of the chat
  latest.json                  pointer to the most recently active chat
  index.json                   recent chats, newest first (capped)

Design rules:
  * Recorder events never block Cursor: the documented response is printed,
    every exception is swallowed, and the script exits 0.
  * Gate events (beforeShellExecution, beforeMCPExecution, beforeReadFile,
    preToolUse) always print a full permission object. Logic lives in gc_gate.
  * Local only. There is no network code in this file.
  * Secrets are redacted before anything is written to disk.
  * Python 3 standard library only (works with stock macOS python3 3.9).

Hook docs: https://cursor.com/docs/hooks
"""
import datetime
import json
import math
import os
import re
import signal
import sys
import tempfile
import time

VERSION = "0.1.0"

# Responses Cursor documents for each hook. beforeSubmitPrompt must allow
# the prompt through; everything else gets an empty object (no-op).
RESPONSES = {"beforeSubmitPrompt": {"continue": True}}
HANDLED_EVENTS = ("sessionStart", "beforeSubmitPrompt", "afterAgentResponse",
                  "stop", "sessionEnd")

MAX_STDIN_CHARS = 20 * 1024 * 1024          # ignore absurd payloads
MAX_TURN_CHARS = int(os.environ.get("GROK_CURSOR_MAX_TURN_CHARS", "100000"))
MAX_CHAT_BYTES = int(os.environ.get("GROK_CURSOR_MAX_CHAT_BYTES", str(2 * 1024 * 1024)))
MAX_INDEX_ENTRIES = int(os.environ.get("GROK_CURSOR_MAX_INDEX", "50"))
PREVIEW_CHARS = 500
TIME_BUDGET_SECONDS = 4                      # recorder events only; a gate's budget is hold + 2
GATE_EVENTS = ("beforeShellExecution", "beforeMCPExecution", "beforeReadFile", "preToolUse")
TURN_MARKER = "<!-- grok-cursor:turn -->"
LEGACY_MARKERS = ("<!-- gb:turn -->",)   # written by the old grok-bridge name

_responded = [False]


def data_home():
    return os.environ.get("GROK_CURSOR_HOME") or os.path.join(
        os.path.expanduser("~"), ".grok-cursor")


def respond_json(obj):
    """Print one JSON reply, exactly once."""
    if _responded[0]:
        return
    _responded[0] = True
    try:
        sys.stdout.write(json.dumps(obj) + "\n")
        sys.stdout.flush()
    except Exception:
        pass

def respond(event):
    """Documented no-op for recorder events."""
    respond_json(RESPONSES.get(event, {}))

def _load_gate():
    here = os.path.dirname(os.path.realpath(__file__))
    for d in (here, os.path.join(here, "..", "lib")):
        if os.path.isfile(os.path.join(d, "gc_gate.py")) and d not in sys.path:
            sys.path.insert(0, d)
    import gc_gate
    return gc_gate

def _deny_fallback(event):
    msg = "grok-cursor: gate error; blocked"
    reply = {"permission": "deny", "user_message": msg}
    if event != "beforeReadFile":
        reply["agent_message"] = msg
    return reply


# --- BEGIN REDACT (keep identical in bin/grok-cursor; tests enforce it) ---
_SECRET_NAME = r"[A-Za-z0-9_.-]*(?:KEY|TOKEN|SECRET|PASSWORD|PASSWD|CREDENTIAL)[A-Za-z0-9_.-]*"
_REDACT_RULES = [
    # PEM private keys (multi-line)
    (re.compile(r"-----BEGIN [A-Z0-9 ]*PRIVATE KEY-----.*?-----END [A-Z0-9 ]*PRIVATE KEY-----",
                re.S), "[REDACTED:private-key]"),
    # .env / shell style:  FOO_API_KEY=value   export GITHUB_TOKEN="..."
    (re.compile(r"(?im)^(\s*(?:export\s+)?" + _SECRET_NAME + r"\s*[=:]\s*)(?!\[REDACTED)(\S.*)$"),
     r"\1[REDACTED]"),
    # quoted config style:  "api_key": "value"   password = 'value'
    (re.compile(r"(?i)([\"']?" + _SECRET_NAME + r"[\"']?\s*[:=]\s*)([\"'])(?!\[REDACTED)[^\"'\n]{4,}\2"),
     r"\1\2[REDACTED]\2"),
    (re.compile(r"\bsk-[A-Za-z0-9_-]{16,}"), "[REDACTED:sk]"),
    (re.compile(r"\b(?:sk|rk)_(?:live|test)_[A-Za-z0-9]{16,}"), "[REDACTED:stripe]"),
    (re.compile(r"\bgh[pousr]_[A-Za-z0-9]{30,}"), "[REDACTED:github]"),
    (re.compile(r"\bgithub_pat_[A-Za-z0-9_]{22,}"), "[REDACTED:github]"),
    (re.compile(r"\b(?:AKIA|ASIA)[0-9A-Z]{16}\b"), "[REDACTED:aws]"),
    (re.compile(r"\bxox[abposr]-[A-Za-z0-9-]{10,}"), "[REDACTED:slack]"),
    (re.compile(r"\bAIza[0-9A-Za-z_-]{35}"), "[REDACTED:google]"),
    (re.compile(r"\beyJ[A-Za-z0-9_-]{8,}\.eyJ[A-Za-z0-9_-]{8,}\.[A-Za-z0-9_-]{8,}"), "[REDACTED:jwt]"),
    (re.compile(r"(?i)\b(Bearer|Basic)\s+[A-Za-z0-9._~+/=-]{16,}"), r"\1 [REDACTED]"),
    # credentials inside URLs: scheme://user:password@host
    (re.compile(r"([a-z][a-z0-9+.-]*://[^\s:/@]+:)[^\s@/]+@"), r"\1[REDACTED]@"),
]


def redact(text):
    if not text or os.environ.get("GROK_CURSOR_REDACT", "1") == "0":
        return text or ""
    for pattern, repl in _REDACT_RULES:
        text = pattern.sub(repl, text)
    return text
# --- END REDACT ---


_TS_RE = re.compile(r"<timestamp>.*?</timestamp>", re.S)
_UQ_RE = re.compile(r"<user_query>\s*(.*?)\s*</user_query>", re.S)


def clean_user_text(text):
    """Strip Cursor's <timestamp>/<user_query> wrappers if present."""
    text = text or ""
    m = _UQ_RE.search(text)
    if m:
        text = m.group(1)
    return _TS_RE.sub("", text).strip()


def now_iso():
    return datetime.datetime.now().astimezone().isoformat(timespec="seconds")


def human_ts(iso):
    return iso.replace("T", " ")


def preview(text, n=PREVIEW_CHARS):
    text = re.sub(r"\s+", " ", text or "").strip()
    return text if len(text) <= n else text[: n - 1].rstrip() + "\u2026"


def cap_text(text):
    if len(text) <= MAX_TURN_CHARS:
        return text
    dropped = len(text) - MAX_TURN_CHARS
    return text[:MAX_TURN_CHARS] + "\n\n[grok-cursor: truncated %d chars]" % dropped


def safe_id(value):
    value = re.sub(r"[^A-Za-z0-9._-]", "_", str(value or "")).strip("._")
    return value[:128]


def as_str_list(value):
    if isinstance(value, str):
        return [value]
    if isinstance(value, list):
        return [v for v in value if isinstance(v, str) and v]
    return []


def project_name(roots, transcript_path):
    if roots:
        base = os.path.basename(roots[0].rstrip("/\\"))
        if base:
            return base
    if transcript_path:
        # ~/.cursor/projects/<slug>/agent-transcripts/...
        parts = transcript_path.replace("\\", "/").split("/")
        if "projects" in parts:
            i = parts.index("projects")
            if i + 1 < len(parts):
                return parts[i + 1]
    return "unknown"


def is_ignored(home, roots, project):
    """~/.grok-cursor/ignore: one substring per line; matching chats are skipped."""
    path = os.path.join(home, "ignore")
    try:
        with open(path, "r", encoding="utf-8") as fh:
            needles = [ln.strip() for ln in fh if ln.strip() and not ln.startswith("#")]
    except OSError:
        return False
    hay = [project] + list(roots)
    return any(n in h for n in needles for h in hay)


# ---------------------------------------------------------------- file utils

def ensure_dir(path):
    os.makedirs(path, mode=0o700, exist_ok=True)


def atomic_write_json(path, obj):
    directory = os.path.dirname(path)
    fd, tmp = tempfile.mkstemp(prefix=".tmp-", dir=directory)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as fh:
            json.dump(obj, fh, indent=2, ensure_ascii=False)
            fh.write("\n")
        os.chmod(tmp, 0o600)
        os.replace(tmp, path)
    except Exception:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


def load_json(path, default):
    try:
        with open(path, "r", encoding="utf-8") as fh:
            return json.load(fh)
    except Exception:
        return default


class Lock(object):
    """Best-effort inter-process lock (hooks can fire concurrently)."""

    def __init__(self, path, timeout=2.0):
        self.path, self.timeout, self.fh = path, timeout, None

    def __enter__(self):
        try:
            import fcntl
            self.fh = os.fdopen(os.open(self.path, os.O_WRONLY | os.O_CREAT, 0o600), "w")
            deadline = time.time() + self.timeout
            while True:
                try:
                    fcntl.flock(self.fh, fcntl.LOCK_EX | fcntl.LOCK_NB)
                    break
                except (IOError, OSError):
                    if time.time() > deadline:
                        break  # proceed unlocked rather than stall Cursor
                    time.sleep(0.02)
        except Exception:
            pass
        return self

    def __exit__(self, *exc):
        try:
            if self.fh:
                self.fh.close()  # closing releases the flock
        except Exception:
            pass
        return False


def log_error(home, message):
    try:
        ensure_dir(home)
        path = os.path.join(home, "hook-errors.log")
        if os.path.exists(path) and os.path.getsize(path) > 256 * 1024:
            os.replace(path, path + ".1")
        with open(path, "a", encoding="utf-8") as fh:
            fh.write("%s %s\n" % (now_iso(), message))
    except Exception:
        pass


# ------------------------------------------------------------- chat markdown

def chat_header(entry, continued_from=None):
    lines = [
        "# Cursor chat: %s" % entry.get("project", "unknown"),
        "",
        "- conversation_id: `%s`" % entry["conversation_id"],
        "- workspace: %s" % (", ".join(entry.get("workspace_roots") or []) or "unknown"),
        "- transcript: %s" % (entry.get("transcript_path") or "n/a"),
        "- started: %s" % human_ts(entry.get("created_at") or now_iso()),
    ]
    if continued_from:
        lines.append("- continued from: %s" % continued_from)
    lines.append("")
    return "\n".join(lines) + "\n"


def append_turn(path, entry, role, ts, text="", detail=""):
    if os.path.exists(path) and os.path.getsize(path) > MAX_CHAT_BYTES:
        rotated = path[:-3] + ".1.md"
        os.replace(path, rotated)          # keep exactly one older segment
        header = chat_header(entry, continued_from=os.path.basename(rotated))
    elif not os.path.exists(path):
        header = chat_header(entry)
    else:
        header = ""
    title = "### %s \u00b7 %s" % (role, human_ts(ts))
    if detail:
        title += " \u00b7 %s" % detail
    body = text or ""
    for marker in (TURN_MARKER,) + LEGACY_MARKERS:
        body = body.replace(marker, "<!-- turn-marker (escaped) -->")
    body = body.rstrip()
    block = "\n%s\n%s\n" % (TURN_MARKER, title)
    if body:
        block += "\n%s\n" % body
    fd = os.open(path, os.O_WRONLY | os.O_APPEND | os.O_CREAT, 0o600)
    with os.fdopen(fd, "a", encoding="utf-8") as fh:
        fh.write(header + block)


# ------------------------------------------------------------------- record

STOP_STATUS = {"completed": "done", "aborted": "aborted", "error": "error"}


def record(event, payload):
    if event not in HANDLED_EVENTS:
        return
    cid = safe_id(payload.get("conversation_id") or payload.get("session_id"))
    if not cid:
        return
    home = data_home()
    roots = as_str_list(payload.get("workspace_roots"))
    if not roots and os.environ.get("CURSOR_PROJECT_DIR"):
        roots = [os.environ["CURSOR_PROJECT_DIR"]]
    transcript = payload.get("transcript_path") or os.environ.get("CURSOR_TRANSCRIPT_PATH")
    project = project_name(roots, transcript)
    if is_ignored(home, roots, project):
        return

    chats = os.path.join(home, "chats")
    ensure_dir(home)
    ensure_dir(chats)
    ts = now_iso()
    chat_file = os.path.join(chats, cid + ".md")

    with Lock(os.path.join(home, ".lock")):
        index = load_json(os.path.join(home, "index.json"), {})
        convs = index.get("conversations") if isinstance(index, dict) else None
        if not isinstance(convs, list):
            convs = []
        entry = None
        for c in convs:
            if isinstance(c, dict) and c.get("conversation_id") == cid:
                entry = c
                break
        if entry is None:
            entry = {"conversation_id": cid, "created_at": ts, "status": "idle",
                     "last_prompt_preview": "", "last_response_preview": ""}
        if roots:
            entry["workspace_roots"] = roots
        entry.setdefault("workspace_roots", [])
        entry["project"] = project if project != "unknown" else entry.get("project", project)
        if transcript:
            entry["transcript_path"] = transcript
        entry.setdefault("transcript_path", None)
        for key in ("generation_id", "model", "cursor_version"):
            if payload.get(key):
                entry[key] = payload.get(key)
        entry["chat_file"] = chat_file
        entry["last_event"] = event
        entry["updated_at"] = ts

        make_latest = True
        role, text, detail = None, "", ""

        if event == "sessionStart":
            entry["composer_mode"] = payload.get("composer_mode")
            entry["is_background_agent"] = bool(payload.get("is_background_agent"))
            make_latest = not entry["is_background_agent"]
            role = "session"
            detail = "started" + (" (%s)" % payload["composer_mode"]
                                  if payload.get("composer_mode") else "")
        elif event == "beforeSubmitPrompt":
            text = cap_text(redact(clean_user_text(payload.get("prompt") or "")))
            atts = payload.get("attachments") or []
            files = [a.get("file_path") for a in atts
                     if isinstance(a, dict) and a.get("file_path")]
            entry["status"] = "working"
            entry["last_prompt_preview"] = preview(text)
            entry["last_attachments"] = [os.path.basename(f) for f in files[:20]]
            if files:
                text += "\n\n_attachments: %s_" % ", ".join(entry["last_attachments"])
            entry["last_prompt_at"] = ts
            entry.pop("ended_at", None)
            role = "user"
        elif event == "afterAgentResponse":
            text = cap_text(redact(payload.get("text") or ""))
            entry["last_response_preview"] = preview(text)
            entry["last_response_at"] = ts
            if entry.get("status") in (None, "", "idle"):
                entry["status"] = "working"
            role = "assistant"
        elif event == "stop":
            raw = str(payload.get("status") or "")
            entry["status"] = STOP_STATUS.get(raw, "done")
            entry["stopped_at"] = ts
            role, detail = "stop", raw or "completed"
        elif event == "sessionEnd":
            reason = str(payload.get("reason") or "")
            entry["ended_at"] = ts
            entry["end_reason"] = reason
            if entry.get("status") == "working":
                entry["status"] = STOP_STATUS.get(reason, "ended")
            role, detail = "session", "ended" + (" (%s)" % reason if reason else "")
            latest = load_json(os.path.join(home, "latest.json"), {})
            make_latest = isinstance(latest, dict) and latest.get("conversation_id") == cid

        convs = [entry] + [c for c in convs
                           if isinstance(c, dict) and c.get("conversation_id") != cid]
        convs = convs[:MAX_INDEX_ENTRIES]
        atomic_write_json(os.path.join(home, "index.json"),
                          {"version": 1, "updated_at": ts, "conversations": convs})
        if make_latest:
            latest = dict(entry)
            latest["grok_cursor_version"] = VERSION
            atomic_write_json(os.path.join(home, "latest.json"), latest)
        if role:
            append_turn(chat_file, entry, role, ts, text, detail)


def _on_timeout(signum, frame):
    event = sys.argv[1] if len(sys.argv) > 1 else ""
    if event in GATE_EVENTS:
        msg = "grok-cursor: no decision in time; stop and wait for the human"
        reply = {"permission": "deny", "user_message": msg}
        if event != "beforeReadFile":
            reply["agent_message"] = msg
        respond_json(reply)
    else:
        respond(event)
    os._exit(0)


def _read_payload():
    try:
        raw = "" if sys.stdin is None or sys.stdin.isatty() else sys.stdin.read(MAX_STDIN_CHARS)
        obj = json.loads(raw) if raw.strip() else {}
        return obj if isinstance(obj, dict) else {}
    except Exception:
        return {}


def main():
    argv_event = sys.argv[1] if len(sys.argv) > 1 else ""
    payload = _read_payload()
    # The event name passed by our hooks.json entry wins: it is the hook slot
    # Cursor is actually invoking, so it decides the response shape.
    event = str(argv_event or payload.get("hook_event_name") or "")
    try:
        signal.signal(signal.SIGALRM, _on_timeout)
        if event in GATE_EVENTS:
            try:
                budget = int(math.ceil(_load_gate().hold_seconds(data_home()) + 2))
            except Exception:
                budget = TIME_BUDGET_SECONDS
            signal.alarm(max(1, budget))
        else:
            signal.alarm(TIME_BUDGET_SECONDS)
    except Exception:
        pass
    if event in GATE_EVENTS:
        try:
            reply = _load_gate().handle(event, payload, data_home())
        except Exception as exc:
            log_error(data_home(), "%s: %s: %r" % (event, type(exc).__name__, exc))
            reply = _deny_fallback(event)
        try:
            signal.alarm(0)
        except Exception:
            pass
        respond_json(reply)
        return
    if event == "stop":
        reply = {}
        try:
            reply = _load_gate().stop_reply(payload, data_home()) or {}
        except Exception as exc:
            log_error(data_home(), "stop: %s: %r" % (type(exc).__name__, exc))
        try:
            _load_gate().note_turn_end(payload, data_home())
        except Exception as exc:
            log_error(data_home(), "note_turn_end: %s: %r" % (type(exc).__name__, exc))
        respond_json(reply)
    else:
        respond(event)
    if os.environ.get("GROK_CURSOR_DISABLE") == "1":
        return
    if event == "beforeSubmitPrompt":
        try:
            _load_gate().note_prompt(payload, data_home())
        except Exception as exc:
            log_error(data_home(), "note_prompt: %s: %r" % (type(exc).__name__, exc))
    try:
        record(event, payload)
    except Exception as exc:  # never let Cursor see a failure
        log_error(data_home(), "%s: %s: %r" % (event, type(exc).__name__, exc))


if __name__ == "__main__":
    try:
        main()
    except BaseException:
        pass
    try:
        event = sys.argv[1] if len(sys.argv) > 1 else ""
        if event in GATE_EVENTS:
            respond_json(_deny_fallback(event))   # no-op if main already replied
        else:
            respond(event)
        sys.stdout.flush()
    except BaseException:
        pass
    os._exit(0)
